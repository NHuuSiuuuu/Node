.slide 
    .inner-menu
        ul
            li
                //- a(href="/admin/dashboard") Tổng quan 
                a(href=`${prefixAdmin}/dashboard`) Tổng quan 
            //- Kiểm tra trong arr permissions có key là product-category_view không?
            if(role.permissions.includes("product-category_view"))
                li
                    a(href=`${prefixAdmin}/products-category/`) Danh mục sản phẩm
            
            if(role.permissions.includes("product_view"))
                li
                    a(href=`${prefixAdmin}/products`) Danh sách sản phẩm  
            
            if(role.permissions.includes("roles_view"))
                li
                    a(href=`${prefixAdmin}/roles`) Nhóm quyền
            
            if(role.permissions.includes("roles_permissions"))
                li
                    a(href=`${prefixAdmin}/roles/permissions`) Phân quyền
            
            if(role.permissions.includes("account_view"))
                li
                    a(href=`${prefixAdmin}/accounts`) Danh sách tài khoản
