extends ../../layouts/default.pug
include ../../mixins/alert.pug


block main
    h1(class="mb-4") Cập nhật thông tin cá nhân
    +alert-error(5000)
    +alert-success(5000)

    form(
        action = `${prefixAdmin}/my-account/edit?_method=PATCH`
        method="POST"
        enctype="multipart/form-data"
    )
        div(class="form-group")
            label(for="title") Họ tên
            input(
                type="text"
                class="form-control"
                id="fullName"
                name="fullName"
                required
                value=user.fullName
            )
        div(class="form-group")
            label(for="title") Email
            input(
                type="text"
                class="form-control"
                id="email"
                name="email"
                required
                value=user.email
            )
        div(class="form-group")
            label(for="title") Mật khẩu
            input(
                type="password"
                class="form-control"
                id="password"
                name="password"
            )
        div(class="form-group")
            label(for="title") Số điện thoại
            input(
                type="text"
                class="form-control"
                id="phone"
                name="phone"
                value=user.phone
            )
        div(
            class="form-group"
            upload-image
            )
            label(for="avatar") avatar
            input(
                type="file"
                class="form-control-file"
                id="avatar"
                name="avatar"
                accept="image/*"
                upload-image-input
            )
            img(
                src=user.avatar
                class="image-preview"
                upload-image-preview
            )

        div(class="form-group")
            button(
                type="submit"
                class="btn btn-primary"
            ) Cập nhật