extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/select-tree.pug

block main
    h1 Cài đặt chung
    +alert-error(5000)
    +alert-success(5000)

    form(
        action=`${prefixAdmin}/settings/general?_method=PATCH`
        method="POST"
        enctype="multipart/form-data"
    )
        div(class="form-group")
            label(for="title") Tên website
            input(
                type="text"
                class="form-control"
                id="websiteName"
                name="websiteName"
                value = (settingGeneral ? settingGeneral.websiteName : "")
            )
        div(
            class="form-group"
            upload-image
            )
            label(for="logo") Logo
            input(
                type="file"
                class="form-control-file"
                id="logo"
                name="logo"
                upload-image-input
                accept="image/*"
            )
            img(
                src = (settingGeneral ? settingGeneral.logo : "")
                class="image-preview"
                upload-image-preview
            )
        div(class="form-group")
            label(for="title") Số điện thoại
            input(
                type="text"
                class="form-control"
                id="phone"
                name="phone"
                value = (settingGeneral ? settingGeneral.phone : "")
                )
        div(class="form-group")
            label(for="title") Địa chỉ
            input(
                type="text"
                class="form-control"
                id="address"
                name="address"
                value = (settingGeneral ? settingGeneral.address : "")
                )
        div(class="form-group")
            label(for="title") Copyright
            input(
                type="text"
                class="form-control"
                id="copyright"
                name="copyright"
                value = (settingGeneral ? settingGeneral.copyright : "")
                )
        //- Thêm các trường facebook hay gì đấy ...
        div(class="form-group")
            button(
                type="submit"
                class="btn  btn-primary"
            ) Cập nhật