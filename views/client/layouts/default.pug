include ../mixins/alert.pug

doctype html
html
    head
        title #{pageTitle}
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css")
        link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css")
        link(rel="stylesheet", href="https://unpkg.com/file-upload-with-preview/dist/style.css")
        
        //- Viewerjs
        link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.7/viewer.css")
        

        link(rel="stylesheet", href="/css/style.css")
    body
        +alert-success(5000)

        include ../partials/header.pug

        block main

        include ../partials/footer.pug
        script(
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"
        )

        //- emoji-picker-element
        script(type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element@^1/index.js") 
        //- End emoji-picker-element

        //- File-upload-with-preview
        //- script(src="https://unpkg.com/file-upload-with-preview/dist/index.js") 
        //- End File-upload-with-preview
        
        //- Socket IO
        script(src="/socket.io/socket.io.js") 
        script(src="/js/socket.js") 

        //- Viewerjs
        script(src="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.7/viewer.min.js") 

        script(type="module" src="/js/chat.js") 

        //- script(src="/js/users.js") 
        

        script(src="/js/script.js")

        block script
